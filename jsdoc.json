{
  "source": {
    "include": ["index.js", "models.js", "auth.js", "passport.js"],
    "includePattern": ".js$",
    "excludePattern": "(node_modules|public)"
  },
  "opts": {
    "destination": "./out",
    "recurse": true,
    "template": "node_modules/better-docs"
  },
  "plugins": ["node_modules/better-docs/category"],
  "package": {
    "name": "myFlix Movie API",
    "version": "1.0.0",
    "description": "A RESTful API built with Express and MongoDB for managing movies, genres, directors, and users."
  }
}
